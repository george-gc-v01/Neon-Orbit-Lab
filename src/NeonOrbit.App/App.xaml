<Application x:Class="NeonOrbit.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#0B121A" />
    <SolidColorBrush x:Key="Panel" Color="#111F2A" />
    <SolidColorBrush x:Key="Ink" Color="#E8F3EE" />
    <SolidColorBrush x:Key="Muted" Color="#A6BBC8" />
    <SolidColorBrush x:Key="Green" Color="#66FF99" />
    <SolidColorBrush x:Key="Blue" Color="#529AFF" />
    <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="#354D60" /><Setter Property="Padding" Value="16,10" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Green}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderThickness" Value="2" /><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Green}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Margin" Value="0,6,0,6" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="CaretBrush" Value="{DynamicResource Green}" /><Setter Property="BorderBrush" Value="#354D60" /><Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="0,4,0,8" /></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Application.Resources>
</Application>

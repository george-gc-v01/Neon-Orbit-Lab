<Window x:Class="NeonOrbit.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NeonOrbit.App" Title="Neon Orbit · Process Lab v2026" Width="570" Height="770" MinWidth="490" MinHeight="600" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24,28,24">
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="NEON ORBIT" FontSize="27" FontWeight="Light" /><TextBlock Text="PROCESS LAB   /   v2026" Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,6,0,0" /></StackPanel>
    <Border Grid.Column="1" VerticalAlignment="Top" Background="{DynamicResource Panel}" BorderBrush="#284738" BorderThickness="1" CornerRadius="12" Padding="10,6"><TextBlock x:Name="ModeLabel" Text="EDUCATIONAL BETA" Foreground="{DynamicResource Green}" FontSize="10" /></Border>
   </Grid>
   <Border CornerRadius="18" Background="{DynamicResource Panel}" BorderBrush="#294150" BorderThickness="1">
    <Grid><local:OrbitVisual x:Name="OrbitArt" Height="225" VerticalAlignment="Top" IsHitTestVisible="False" />
     <StackPanel Margin="24,222,24,23"><TextBlock Text="CURRENT NEON STATE" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="StateLabel" Text="Neon high 25:00" Foreground="{DynamicResource Green}" FontSize="34" FontWeight="Light" Margin="0,5,0,8" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="PhaseLabel" Foreground="{DynamicResource Muted}" FontSize="12" Text="Your movement takes priority." /><ProgressBar x:Name="PhaseProgress" Height="3" Minimum="0" Maximum="1" Value="1" Foreground="{DynamicResource Green}" Background="#203746" BorderThickness="0" Margin="0,16,0,0" /></StackPanel>
    </Grid>
   </Border>
   <Grid Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ORBIT" FontSize="10" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="DiameterLabel" Text="20 mm · 7 s" Margin="0,5,0,0" /></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="DISPLAY" FontSize="10" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="DpiLabel" Text="DPI pending" Margin="0,5,0,0" /></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="MOVEMENTS" FontSize="10" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="CountLabel" Text="0" Margin="0,5,0,0" /></StackPanel>
   </Grid>
   <WrapPanel Margin="0,0,0,17"><Button Content="Start" Click="StartClick" Background="{DynamicResource Green}" Foreground="#07140C" /><Button Content="Stop" Click="StopClick" /><Button Content="Minimise" Click="MinimiseClick" /><Button Content="Close App" Click="CloseClick" Margin="0" /></WrapPanel>
   <CheckBox x:Name="AwakeToggle" Content="Keep Windows awake" IsChecked="True" Click="PowerChanged" />
   <TextBlock x:Name="AwakeHint" Text="Independent of motion · display may turn off" Foreground="{DynamicResource Muted}" FontSize="11" Margin="21,0,0,10" />
   <Expander Header="LAB SETTINGS" Foreground="{DynamicResource Ink}" Margin="0,9,0,12">
    <StackPanel Margin="0,12,0,0">
     <CheckBox x:Name="DisplayToggle" Content="Keep display awake too" Click="PowerChanged" />
     <CheckBox x:Name="LogToggle" Content="Local experimental log" IsChecked="True" Click="LoggingChanged" />
     <CheckBox x:Name="TestToggle" Content="Accelerated Test Mode (phase minutes become seconds)" />
     <CheckBox x:Name="MotionToggle" Content="Reduce visual animations" />
     <CheckBox x:Name="MinimiseToggle" Content="Minimise shortly after launch" IsChecked="True" />
     <TextBlock Text="Randomness" Margin="0,10,0,4" /><ComboBox x:Name="RandomChoice" SelectedIndex="0"><ComboBoxItem Content="Secure" /><ComboBoxItem Content="Seeded" /><ComboBoxItem Content="Hybrid" /></ComboBox>
     <TextBlock Text="Experiment seed" Margin="0,10,0,0" /><TextBox x:Name="SeedBox" Text="2026" AutomationProperties.Name="Experiment seed" />
     <CheckBox x:Name="ReplayToggle" Content="Include entropy seeds for sampler replay" />
     <TextBlock Text="Diameter (mm) / revolution (seconds)" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBox x:Name="DiameterBox" Text="20" Margin="0,4,8,8" AutomationProperties.Name="Diameter millimetres" /><TextBox x:Name="PeriodBox" Grid.Column="1" Text="7" AutomationProperties.Name="Revolution seconds" /></Grid>
     <TextBlock Text="Physical calibration: pixels per mm (0 = DPI estimate)" /><TextBox x:Name="CalibrationBox" Text="0" AutomationProperties.Name="Pixels per millimetre" />
     <TextBlock Text="Measure a 100-pixel line on your monitor; divide 100 by its measured mm. Calibration is monitor-specific; reset when switching monitors." Foreground="{DynamicResource Muted}" FontSize="11" /><Border Width="100" Height="2" Background="{DynamicResource Green}" HorizontalAlignment="Left" Margin="0,10,0,12" x:Name="CalibrationLine" />
     <TextBlock Text="Maximum session (minutes)" /><TextBox x:Name="MaxBox" Text="240" AutomationProperties.Name="Maximum session minutes" />
     <TextBlock Text="Normal parameters: mean / sigma / minimum / maximum" FontSize="11" Foreground="{DynamicResource Muted}" />
     <TextBox x:Name="HighBox" Text="25 / 5 / 15 / 50" AutomationProperties.Name="High distribution" />
     <TextBox x:Name="LowBox" Text="7.5 / 2 / 3 / 15" AutomationProperties.Name="Low distribution" />
     <TextBox x:Name="WowBox" Text="8 / 4 / 1 / 25" AutomationProperties.Name="Wow recovery distribution" />
     <TextBlock Text="Apply starts a new experiment. Test timing is never saved." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" />
     <Button Content="Apply settings and restart" Click="ApplyClick" HorizontalAlignment="Left" />
    </StackPanel>
   </Expander>
   <WrapPanel><Button Content="Export report" Click="ExportClick" Padding="10,6" /><Button Content="Open logs" Click="OpenLogsClick" Padding="10,6" /><Button Content="Delete session log" Click="DeleteLogClick" Padding="10,6" /></WrapPanel>
   <TextBlock x:Name="NoticeLabel" Text="LOCAL ONLY   ·   CTRL + ALT + F12 TO STOP" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,16,0,0" />
   <TextBlock Text="Your input always has priority. No clicks, screenshots or personal paths are recorded." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" />
   <Button Content="About · Privacy · GPL-3.0" Click="AboutClick" HorizontalAlignment="Left" Padding="8,5" Margin="0,12,0,0" />
  </StackPanel>
 </ScrollViewer>
</Window>
